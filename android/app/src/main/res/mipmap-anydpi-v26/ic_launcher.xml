<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon (API 26+). The launcher masks these two layers to whatever
  shape the device uses — circle, squircle, rounded square — so the artwork
  lives in the foreground's inner safe zone and the background is a flat fill.

  Without this the launcher fell back to the legacy square bitmap and drew its
  own white outline around it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
